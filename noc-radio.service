[Unit]
Description=NOC Radio Manager
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/projects/noc-radio
ExecStart=/home/ubuntu/projects/noc-radio/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8110
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
